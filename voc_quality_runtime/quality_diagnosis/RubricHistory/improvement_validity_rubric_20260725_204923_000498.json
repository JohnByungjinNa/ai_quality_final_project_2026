{
  "version": "1.1",
  "rubric_id": "VOC-IMPROVEMENT-VALIDITY-100",
  "title": "최종 개선안 타당성 100점 검증 기준",
  "total_points": 100,
  "dimensions": {
    "cause_linkage": {
      "label": "불만 원인과 개선안 연결",
      "max_points": 20,
      "pass_floor": 18,
