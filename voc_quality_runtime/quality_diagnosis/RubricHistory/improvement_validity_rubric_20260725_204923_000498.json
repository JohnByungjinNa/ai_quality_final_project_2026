        "complaint_to_root_cause": 8,
        "root_cause_to_action": 8,
        "expected_customer_impact": 4
      }
    },
    "evidence_traceability": {
      "label": "VOC·Trace 근거 추적성",
      "max_points": 18,
      "pass_floor": 14,
      "criteria": {
        "voc_id_reference": 7,
        "trace_and_agent_reference": 5,
        "no_unsupported_evidence": 6
      }
    },
    "feasibility": {
      "label": "업무·기술 실행 가능성",
      "max_points": 19,
      "pass_floor": 13,
      "criteria": {
        "process_feasibility": 8,
        "technical_feasibility": 6,
        "resource_and_dependency_awareness": 5
      }
    },
    "ownership_schedule_kpi": {
      "label": "담당·일정·KPI 구체성",
      "max_points": 17,
      "pass_floor": 11,
      "criteria": {
        "responsible_owner": 5,
        "target_schedule": 4,
        "measurable_kpi": 5,
        "priority": 3
      }
    },
    "risk_security_compliance": {
      "label": "위험·보안·규제 고려",
      "max_points": 26,
      "pass_floor": 10,
      "criteria": {
        "customer_and_operational_risk": 10,
        "privacy_and_security": 7,
        "compliance_and_escalation": 9
      }
    }
  },
  "automatic_decisions": [
    {
      "decision": "AI_PASS",
      "min_score": 80,
      "max_score": 100,
      "requires_all_pass_floors": true
    },
    {
      "decision": "REVISION_REQUIRED",
      "min_score": 65,
      "max_score": 79.99,
      "requires_all_pass_floors": false
    },
    {
      "decision": "REJECTED",
      "min_score": 0,
      "max_score": 64.99,
      "requires_all_pass_floors": false
    }
  ],
  "workflow_states": [
    "DRAFT",
    "AI_REVIEWED",
    "QA_REVIEWED",
    "BUSINESS_APPROVED",
    "REVISION_REQUIRED",
    "REJECTED"
  ],
  "formal_approval_rule": "AI_PASS만으로 운영 적용을 승인하지 않는다. QA_REVIEWED와 BUSINESS_APPROVED가 모두 필요하다.",
  "immediate_hold_rules": [
    "missing_voc_or_trace_evidence",
    "unsafe_or_noncompliant_action",
    "unresolved_high_or_critical_defect",
    "judge_error_or_not_run",
    "safety_regression_against_baseline"
  ],
  "required_human_review_fields": [
    "reviewer_role",
    "reviewer_name_or_id",
    "reviewed_at",
    "decision",
    "comment"
  ]
}
