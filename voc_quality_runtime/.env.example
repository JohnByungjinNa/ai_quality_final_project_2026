# Copy to .env and replace placeholders with newly issued keys.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY
TAVILY_API_KEY=YOUR_TAVILY_API_KEY

# Models
A2A_MODEL_SUMMARY=gpt-5.2
A2A_MODEL_POLICY=claude-haiku-4-5
A2A_MODEL_JUDGE_ANTHROPIC=claude-haiku-4-5
A2A_MODEL_JUDGE_OPENAI=gpt-5.2
A2A_MODEL_JUDGE_GEMINI=gemini-3.5-flash-lite
A2A_MODEL_GEMINI=gemini-3.5-flash-lite
A2A_MODEL_VALIDITY_ANTHROPIC=claude-haiku-4-5
A2A_MODEL_VALIDITY_OPENAI=gpt-5.2
A2A_MODEL_VALIDITY_GEMINI=gemini-3.5-flash-lite

# Optional Judge cost calculation. Leave unset until verified KRW/1M-token rates are available.
# A2A_JUDGE_ANTHROPIC_INPUT_KRW_PER_MTOK=
# A2A_JUDGE_ANTHROPIC_OUTPUT_KRW_PER_MTOK=
# A2A_JUDGE_OPENAI_INPUT_KRW_PER_MTOK=
# A2A_JUDGE_OPENAI_OUTPUT_KRW_PER_MTOK=

