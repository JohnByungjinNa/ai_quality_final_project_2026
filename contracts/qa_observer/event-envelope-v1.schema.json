{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ai-quality.example/contracts/qa-observer/event-envelope-v1.schema.json",
  "title": "QA Observer Event Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "occurred_at",
    "source",
    "context",
    "dedup_key",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "api.request.completed",
        "llm.call.completed",
        "rag.search.completed",
        "quality.evaluation.completed",
        "test.run.completed",
        "safety.violation.detected",
        "defect.changed",
        "evidence.upload.completed",
        "collector.sync.completed"
      ]
    },
    "schema_version": {
      "const": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "context": {
      "$ref": "#/$defs/context"
    },
    "dedup_key": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {"properties": {"event_type": {"const": "api.request.completed"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/api_request_payload"}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "llm.call.completed"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/llm_call_payload"}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "rag.search.completed"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/rag_search_payload"}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "quality.evaluation.completed"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/quality_evaluation_payload"}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "test.run.completed"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/test_run_payload"}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "safety.violation.detected"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/safety_payload"}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "defect.changed"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/defect_payload"}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "evidence.upload.completed"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/evidence_upload_payload"}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "collector.sync.completed"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/collector_payload"}}}
    }
  ],
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component"],
      "properties": {
        "component": {"type": "string", "minLength": 1, "maxLength": 64},
        "instance": {"type": ["string", "null"], "maxLength": 128}
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment", "service"],
      "properties": {
        "environment": {
          "type": "string",
          "enum": ["local", "dev", "stage", "prod"]
        },
        "service": {"type": "string", "minLength": 1, "maxLength": 64},
        "trace_id": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{32}$"
        },
        "run_id": {"type": ["string", "null"], "maxLength": 128},
        "case_id": {"type": ["string", "null"], "maxLength": 128}
      }
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^hmac-sha256:v[0-9]+:[0-9a-f]{64}$"
    },
    "decision": {
      "type": "string",
      "enum": ["PASS", "REVIEW", "FAIL", "ERROR"]
    },
    "severity": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "metric_score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluated"],
      "properties": {
        "evaluated": {"type": "boolean"},
        "score": {"type": ["number", "null"], "minimum": 1, "maximum": 5}
      }
    },
    "api_request_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "route_template", "status_code", "duration_ms", "timeout"],
      "properties": {
        "method": {"type": "string", "minLength": 1, "maxLength": 16},
        "route_template": {"type": "string", "minLength": 1, "maxLength": 256},
        "status_code": {"type": "integer", "minimum": 100, "maximum": 599},
        "duration_ms": {"type": "integer", "minimum": 0},
        "timeout": {"type": "boolean"},
        "error_type": {"type": ["string", "null"], "maxLength": 128}
      }
    },
    "llm_call_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider", "model", "operation", "status", "input_tokens",
        "output_tokens", "cached_input_tokens", "total_tokens", "duration_ms"
      ],
      "properties": {
        "provider": {"type": "string", "minLength": 1, "maxLength": 64},
        "model": {"type": "string", "minLength": 1, "maxLength": 128},
        "operation": {"type": "string", "minLength": 1, "maxLength": 64},
        "status": {"type": "string", "enum": ["success", "error"]},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "cached_input_tokens": {"type": "integer", "minimum": 0},
        "reasoning_tokens": {"type": "integer", "minimum": 0, "default": 0},
        "total_tokens": {"type": "integer", "minimum": 0},
        "duration_ms": {"type": "integer", "minimum": 0},
        "prompt_fingerprint": {"anyOf": [{"$ref": "#/$defs/fingerprint"}, {"type": "null"}]},
        "prompt_chars": {"type": ["integer", "null"], "minimum": 0},
        "response_fingerprint": {"anyOf": [{"$ref": "#/$defs/fingerprint"}, {"type": "null"}]},
        "response_chars": {"type": ["integer", "null"], "minimum": 0},
        "price_snapshot_id": {"type": ["string", "null"], "maxLength": 128},
        "input_cost_micros_krw": {"type": ["integer", "null"], "minimum": 0},
        "output_cost_micros_krw": {"type": ["integer", "null"], "minimum": 0},
        "total_cost_micros_krw": {"type": ["integer", "null"], "minimum": 0},
        "error_type": {"type": ["string", "null"], "maxLength": 128}
      }
    },
    "rag_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rank", "document_fingerprint", "chunk_fingerprint", "score"],
      "properties": {
        "rank": {"type": "integer", "minimum": 1},
        "document_fingerprint": {"anyOf": [{"$ref": "#/$defs/fingerprint"}, {"type": "null"}]},
        "chunk_fingerprint": {"anyOf": [{"$ref": "#/$defs/fingerprint"}, {"type": "null"}]},
        "score": {"type": "number"}
      }
    },
    "rag_search_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_fingerprint", "query_chars", "top_k", "result_count",
        "no_result", "duration_ms", "results"
      ],
      "properties": {
        "query_fingerprint": {"anyOf": [{"$ref": "#/$defs/fingerprint"}, {"type": "null"}]},
        "query_chars": {"type": "integer", "minimum": 0},
        "top_k": {"type": "integer", "minimum": 1},
        "result_count": {"type": "integer", "minimum": 0},
        "no_result": {"type": "boolean"},
        "duration_ms": {"type": "integer", "minimum": 0},
        "expected_document_fingerprint": {"anyOf": [{"$ref": "#/$defs/fingerprint"}, {"type": "null"}]},
        "top_k_hit": {"type": ["boolean", "null"]},
        "results": {
          "type": "array",
          "items": {"$ref": "#/$defs/rag_result"},
          "maxItems": 100
        }
      }
    },
    "quality_evaluation_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluation_id", "evaluator_type", "overall_decision", "scores"],
      "properties": {
        "evaluation_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "evaluator_type": {"type": "string", "enum": ["rule", "llm_judge", "human"]},
        "overall_decision": {"$ref": "#/$defs/decision"},
        "summary_code": {"type": ["string", "null"], "maxLength": 128},
        "safety_violation_severity": {
          "anyOf": [{"$ref": "#/$defs/severity"}, {"type": "null"}]
        },
        "scores": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/metric_score"}
        }
      }
    },
    "test_run_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "started_at", "ended_at", "duration_ms", "criteria_stage",
        "pass_count", "fail_count", "error_count", "total_count"
      ],
      "properties": {
        "started_at": {"type": "string", "format": "date-time"},
        "ended_at": {"type": "string", "format": "date-time"},
        "duration_ms": {"type": "integer", "minimum": 0},
        "criteria_stage": {"type": "string", "minLength": 1, "maxLength": 64},
        "pass_count": {"type": "integer", "minimum": 0},
        "fail_count": {"type": "integer", "minimum": 0},
        "error_count": {"type": "integer", "minimum": 0},
        "total_count": {"type": "integer", "minimum": 0},
        "source_manifest_path": {"type": ["string", "null"], "maxLength": 512}
      }
    },
    "safety_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "severity", "action", "blocked"],
      "properties": {
        "category": {"type": "string", "minLength": 1, "maxLength": 128},
        "severity": {"$ref": "#/$defs/severity"},
        "action": {"type": "string", "minLength": 1, "maxLength": 128},
        "blocked": {"type": "boolean"},
        "content_fingerprint": {"anyOf": [{"$ref": "#/$defs/fingerprint"}, {"type": "null"}]},
        "policy_version": {"type": ["string", "null"], "maxLength": 64}
      }
    },
    "defect_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defect_id", "action", "defect_type", "severity", "status", "summary_code"],
      "properties": {
        "defect_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "action": {"type": "string", "enum": ["opened", "updated", "resolved", "closed"]},
        "defect_type": {"type": "string", "minLength": 1, "maxLength": 128},
        "severity": {"$ref": "#/$defs/severity"},
        "status": {"type": "string", "enum": ["open", "investigating", "resolved", "closed"]},
        "summary_code": {"type": "string", "minLength": 1, "maxLength": 128},
        "external_system": {"type": ["string", "null"], "maxLength": 64},
        "external_issue_key": {"type": ["string", "null"], "maxLength": 128}
      }
    },
    "collector_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_name", "status", "items_processed"],
      "properties": {
        "source_name": {"type": "string", "minLength": 1, "maxLength": 128},
        "status": {"type": "string", "enum": ["success", "error"]},
        "items_processed": {"type": "integer", "minimum": 0},
        "checkpoint": {"type": ["string", "null"], "maxLength": 512},
        "error_type": {"type": ["string", "null"], "maxLength": 128}
      }
    },
    "evidence_upload_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "uploaded", "verified", "duration_ms", "file_count", "bytes_total"],
      "properties": {
        "status": {"type": "string", "enum": ["success", "error"]},
        "uploaded": {"type": "boolean"},
        "verified": {"type": "boolean"},
        "duration_ms": {"type": "integer", "minimum": 0},
        "file_count": {"type": "integer", "minimum": 0},
        "bytes_total": {"type": "integer", "minimum": 0},
        "error_type": {"type": ["string", "null"], "maxLength": 128}
      }
    }
  }
}
